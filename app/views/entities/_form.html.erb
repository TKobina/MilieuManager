<%= form_with model: @entity do |form| %>
  <div>
    <%= form.submit "Save", class: "form-button" %>
    <%= hidden_field_tag :current_milieu, @milieu.id %>
  </div>
  <p>
    <div>
    <%= form.check_box :public %>
    <strong><%= form.label "Public?" %></br></br></strong>
  </div>
  <div>
    <%= form.text_field :name, class: "text-field"%>
    <strong><%= form.label "Name" %></br></br></strong>
  </div>
  <div>
    <%= form.text_field :kind, class: "text-field"%>
    <strong><%= form.label "Type of Entity" %></br></br></strong>
  </div>
  <div>
    <strong><%= form.label :private_details %></br></strong>
    <%= text_area_tag :textpri, @entity.text["pri"] || "" , class: "large-text-area"%></br>
  </div>
    <div>
    <strong><%= form.label :public_details %></br></strong>
    <%= text_area_tag :textpub, @entity.text["pub"] || "" , class: "large-text-area"%></br>
  </div>
  </p>
<% end %>