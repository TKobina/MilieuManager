</br><%= link_to "Back", :back, class: "form-button" %></br>
<% if @owner %>
  <%= link_to "Edit Milieu", edit_milieu_path(@milieu.id), data: { controller: "tooltip", tooltip_content_value: "A helpful tip for the link" }, class: "form-button"%></br>
  <%= link_to "Add Chapter", new_story_path(current_milieu: @milieu), class: "form-button" %></br>
<% end %>

<h1><%= @milieu.name %></h1>
<%= markdown(@milieu.details ||= "", @milieu, request)%>

<% if @owner %>
<table class="left-aligned-table"> <!-- Add CSS classes for styling (e.g., Tailwind CSS) -->
  <thead>
    <tr>
      <th>Number </th>
      <th>Title</th>
      <th>Words</th>
    </tr>
  </thead>
  <tbody>
    <% @stories.each do |story| %>
      <tr>
        <td><%= story.chapter %></td>
        <td><%= link_to story.title, story_path(story.id, current_milieu: @milieu) %></td>
        <td><%= story.details.split.count %></td>
      </tr>
    <% end %>
  </tbody>
</table>
</br><%= button_to "Delete Milieu", @milieu, method: :delete, data: { turbo_confirm: "Are you sure?" }, params: { current_milieu: @milieu}, class: "form-button" %>
<% else %>

<ul class="list-disc list-inside pl-2">
<div id="stories">
  <% @stories.each do |story| %>
    <div><li class="marker:text-dlavender">
      <strong><%= link_to story.title, story_path(story.id, current_milieu: @milieu) %></strong> 
    </li></div>
  <% end %>
  </ul>
</div>
</p>

<% end %>
